{
  "name": "logiclash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine/tsconfig.json && tsc -p packages/app/tsconfig.json && tsc -p packages/server/tsconfig.json && tsc -p tsconfig.json",
    "dev": "npm run dev -w @logiclash/app",
    "server": "npm run start -w @logiclash/server",
    "build": "npm run build -w @logiclash/app",
    "preview": "npm run preview -w @logiclash/app",
    "play": "tsx scripts/play.ts",
    "survey": "tsx scripts/survey.ts",
    "check": "npm run typecheck && npm run test",
    "share": "npm run build && npm run server"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "puppeteer": "^25.8.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
